```gitignore
# Python compiled files
*.pyc
__pycache__/

# Database files
*.db
*.db-shm
*.db-wal

# Logs
*.log

# Build artifacts
build/
dist/
*.exe

# Environment files
.env
.env.local
*.env.*

# Dependencies
.venv/
venv/
node_modules/

# Editors/IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```